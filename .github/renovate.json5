// Renovate configuration. Schema: https://docs.renovatebot.com/renovate-schema.json
{
  extends: [
    "config:recommended",
    // Keep the noise down: one semantic commit type for everything Renovate does.
    ":semanticCommitTypeAll(chore)",
    // No time gating — a matching base/akmods pair should land the moment
    // Renovate sees it, day or night. The build-then-push failure model
    // (build.yml builds first, publishes second) is what makes any-hour
    // automerge safe: a bad update leaves the PR red and publishes nothing.
  ],

  timezone: "America/Los_Angeles",

  // Everything is pinned by digest. That is the whole point of pinning a bootc
  // base: a rebuild today and a rebuild next month produce the same layers below
  // ours, and the base bump becomes a reviewable commit instead of an invisible
  // change in a floating tag.
  pinDigests: true,

  labels: ["dependencies"],
  prConcurrentLimit: 5,
  prHourlyLimit: 0,

  // Renovate must not touch the extracted upstream trees or the research notes.
  ignorePaths: [
    "trees/**",
    "build-test/**",
    "docs/**",
  ],

  packageRules: [
    // ------------------------------------------------------------------
    // Base image: ghcr.io/ublue-os/kinoite-nvidia, tracked via its rolling
    // `latest` tag. Digest bumps therefore include the day ublue promotes
    // `latest` from Fedora N to N+1 — which is exactly how this repo follows
    // Fedora with no manual edit.
    //
    // AUTOMERGED, but only on green CI. That is safe because of the failure
    // model: the workflow builds first and pushes second, so a base that breaks
    // the build leaves the PR red, publishes nothing, and leaves the running
    // deployment on the last good image. `ignoreTests` is deliberately NOT set —
    // requiring the full build to pass is the entire safety mechanism.
    // ------------------------------------------------------------------
    {
      matchPackageNames: ["ghcr.io/ublue-os/kinoite-nvidia"],
      matchUpdateTypes: ["digest", "pinDigest"],
      groupName: "base image",
      commitMessageTopic: "kinoite-nvidia base",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      // No per-rule schedule here — the global `schedule:nonOfficeHours` extend
      // above already covers "don't race a hand-triggered rebuild". A narrower
      // window (this used to be "after 4am and before 7am" Pacific) doesn't buy
      // anything: ublue-os/main's own build-latest.yml has no cron trigger at
      // all (verified 2026-09-17 by reading it directly) — it rebuilds on PR
      // merge, at unpredictable times — so there is no upstream cadence to
      // align a narrow window against. A wider window just gives Renovate more
      // chances per day to catch a base digest that has a matching akmods
      // build, which is the whole point of the dynamic-resolution fix below.
      // Renovate's default recreateWhen=auto only recreates "immortal" PRs, and
      // skips opening a new PR if a CLOSED PR already exists with the exact same
      // title (same target digest) — confirmed live 2026-09-17: closed PR #80
      // ("Update kinoite-nvidia base to 44121f6") blocked Renovate from proposing
      // that same digest again after a deliberate rollback needed it re-proposed.
      // Base-image bumps are expected to get closed/superseded routinely as part
      // of normal maintenance (a manual rollback, a race with another change), so
      // always allow recreation rather than risk a permanently stuck title.
      recreateWhen: "always",
    },

    // ------------------------------------------------------------------
    // akmods is intentionally NOT tracked by Renovate. AKMODS_TAG in the
    // Containerfile is a bare floating tag (main-44), resolved to a matching
    // digest at build time by build.yml's "Resolve matching akmods digest" step,
    // which reads both images' `ostree.linux` label and picks whichever akmods
    // digest actually matches the base pinned above right now.
    //
    // Why: akmods republishes main-44 roughly daily, independently of when
    // kinoite-nvidia republishes its own `latest`. Pinning both by digest via two
    // separate Renovate rules (the old design) meant the two pins agreed only by
    // chance — Renovate opened one PR per side, each bumping only its own ARG, so
    // neither PR alone could ever land a matched pair even when one briefly
    // existed upstream. That is a structural property of having two independent
    // pins, not something any Renovate scheduling option fixes.
    //
    // enabled: false is REQUIRED here, not just "no packageRule for it" — the
    // repo-level pinDigests: true applies globally regardless of whether a
    // dependency's version is recognized, and akmods's `main-44` value is
    // unversioned under docker versioning ("Dependency ghcr.io/ublue-os/akmods
    // has unsupported/unversioned value main-44"). Without this rule Renovate
    // still opens a "renovate/pin-dependencies" PR pinning AKMODS_TAG to a
    // digest — confirmed live on 2026-09-17, the exact coupling this fix exists
    // to remove, resurrected through the global pin default instead of a
    // dedicated packageRule.
    //
    // The main-44 -> main-45 move is still the one annual manual edit in this
    // repo: bump the bare tag in the Containerfile once the base has actually
    // crossed to F45. Renovate does not do this for the same reason it never
    // touched AKMODS_TAG's Fedora-major digit before: doing it early would break
    // kmods against a base that has not moved yet.
    // ------------------------------------------------------------------
    {
      matchPackageNames: ["ghcr.io/ublue-os/akmods"],
      enabled: false,
    },


    // ------------------------------------------------------------------
    // bootc-image-builder is referenced as a floating :latest in
    // build-disk.yml on purpose — ISO builds are manual and infrequent, and the
    // builder's fixes land fast. Nothing to pin.
    // ------------------------------------------------------------------
    {
      matchPackageNames: ["ghcr.io/osbuild/bootc-image-builder"],
      enabled: false,
    },

    // ------------------------------------------------------------------
    // GitHub Actions are pinned to commit SHAs (a tag like `v4` is mutable and
    // is the standard vector for a compromised action). Renovate keeps the SHA
    // current and rewrites the trailing `# vX` comment, so these are safe to
    // automerge once CI is green.
    // ------------------------------------------------------------------
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
      pinDigests: true,
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },

    // ------------------------------------------------------------------
    // Nerd Fonts is pinned to an exact release tag in build_files/40-fonts.sh.
    // Not automerged: a font release occasionally renames an archive, which
    // only shows up as a build failure.
    // ------------------------------------------------------------------
    {
      matchDepNames: ["ryanoasis/nerd-fonts"],
      groupName: "nerd-fonts",
      automerge: false,
    },
  ],

  customManagers: [
    {
      // NERD_FONTS_VERSION="v3.4.0" in build_files/40-fonts.sh
      customType: "regex",
      managerFilePatterns: ["/^build_files/40-fonts\\.sh$/"],
      matchStrings: ['NERD_FONTS_VERSION="(?<currentValue>v[^"]+)"'],
      depNameTemplate: "ryanoasis/nerd-fonts",
      datasourceTemplate: "github-releases",
    },
    // NOTE: cicpoffs is intentionally absent. ublue-os/cicpoffs publishes one
    // rolling release tagged `master` with assets re-uploaded in place, so there
    // is no version for Renovate to track. See build_files/20-packages-thirdparty.sh.
  ],

  // The dashboard issue is the single place to see what was deferred — Fedora
  // rebases, in particular.
  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate: dependency dashboard",
}
